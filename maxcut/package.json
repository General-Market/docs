{
  "name": "maxcut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n ui,api -c magenta,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:ui": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --quiet",
    "test": "vitest run"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.438",
    "@remotion/player": "4.0.438",
    "@remotion/renderer": "4.0.438",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "fluent-ffmpeg": "^2.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.438",
    "zod": "^3.23.8",
    "zustand": "^4.5.5",
    "zundo": "^2.2.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.7.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
