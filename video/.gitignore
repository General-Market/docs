node_modules/
dist/
out/
.DS_Store
.env

# Media assets (too large for git)
public/
blender_render/
# Exception: scene-image avatars baked from prefetch — small PNGs/JPGs
# needed by Remotion to render the Rainbows-Pitch source cards offline.
!public/scene-images/
!public/scene-images/**
# Exception: cheat-broll directory needs to be re-included before the
# *.mp4 block at the bottom; the per-file mp4 exception sits after it.
!public/cheat-broll/
!public/cheat-broll/**
# Exception: anticheat-imgs — stills used by the AntiCheat compositions.
!public/anticheat-imgs/
!public/anticheat-imgs/**

# Media files anywhere
*.mp4
*.mp3
*.wav
*.ogg
*.flac
*.webm
*.avi
*.mov
*.mkv

# Per-file exception that must come after *.mp4 to take effect.
!public/cheat-broll/*.mp4
