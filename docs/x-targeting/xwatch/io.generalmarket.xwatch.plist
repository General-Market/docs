<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.generalmarket.xwatch</string>

    <!-- Runs from ~/Library/Application Support, NOT the repo: ~/Downloads is a
         TCC-protected folder that launchd may not read. install.sh deploys a
         copy here. The launcher pins sys.path from its own location. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/maxguillabert/Library/Application Support/xwatch/run_xwatch.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/maxguillabert/Library/Application Support/xwatch</string>

    <!-- keep it alive around the clock: commands work any hour;
         the daemon itself only SCANS inside the 10:00–22:00 window -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/maxguillabert/Library/Application Support/xwatch/xwatch/state/xwatch.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maxguillabert/Library/Application Support/xwatch/xwatch/state/xwatch.err.log</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
