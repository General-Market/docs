# xwatch credentials — copy to `.env` (which is git-ignored) and fill in.

# ── twitterapi.io ──────────────────────────────────────────────────
# 100,000 credits = $1.00. advanced_search bills per tweet returned.
# (The old /tmp/.twapi_key file is used as a fallback if this is unset,
#  but /tmp clears on reboot, so set it here for a long-lived daemon.)
TWITTERAPI_API_KEY=

# ── Telegram ───────────────────────────────────────────────────────
# Make a NEW bot with @BotFather (/newbot), paste its token here.
TELEGRAM_BOT_TOKEN=PUT-YOUR-BOTFATHER-TOKEN-HERE
# Where pings land. Defaults to Max's user id (same chat Jarvis uses).
TELEGRAM_CHAT_ID=5688211833
