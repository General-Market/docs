# Dockerfile.rust - Multi-stage build for Rust binaries (issuer, ap)
#
# Stage 1: Build the Rust binaries
# Stage 2: Create minimal runtime image

# ============ Build Stage ============
FROM rust:1.83-slim-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY common/ ./common/
COPY issuer/ ./issuer/
COPY ap/ ./ap/
COPY data-node/ ./data-node/

# Build release binaries
RUN cargo build --release -p issuer -p ap -p data-node

# ============ Runtime Stage ============
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    procps \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create logs directory
RUN mkdir -p /app/logs

# Copy binaries from builder
COPY --from=builder /app/target/release/issuer /usr/local/bin/
COPY --from=builder /app/target/release/ap /usr/local/bin/
COPY --from=builder /app/target/release/data-node /usr/local/bin/

# Add non-root user for security
RUN useradd -r -s /bin/false index
RUN chown -R index:index /app
USER index

# Default to issuer (can be overridden in docker-compose)
CMD ["issuer", "--help"]
