Cargo.lock
*.rs.bk

# Logs (runtime)
/logs/
*.log

# Deployment addresses (generated)
/deployments/local.json
/deployments/l3-testnet.json

# PID files
.pids
.pids.info

# Environment sentinel
.active-env

# IDE
.idea/
.vscode/
*.swp
*.swo
.cursor/
.windsurf/

# OS
.DS_Store
Thumbs.db

# VS Code Local History
.history/

# Environment files
*.env
*.env.local
!*.env.example
!*.env.local.example
# Allow versioned per-env configs in envs/
!envs/
!envs/**
# Manager keys live in envs/<env>/keys/ — never commit
envs/*/keys/
envs/*/keys/**

# Node modules
node_modules/

# Foundry
/contracts/cache/
/contracts/out/
/contracts/broadcast/

# Claude Code
CLAUDE.md
.claude/settings.local.json
.claude/worktrees/

# Vercel & worktrees
.vercel/
.worktrees/

# Playwright MCP logs
.playwright-mcp/

# Test results
test-results/
frontend/test-results/

# Runtime data (re-fetchable)
data/bitget-all-pairs.json
data/exchange-listings.json
data/deployed-tokens-all.json
data/creation-prices.json
data/creation-spreads.json
data/symbol-map.json
data/symbol-map-local.json

# Media files
*.mp3
*.wav
*.mp4
# Exception: source b-roll videos ship to production
!frontend/public/source-video/*.mp4
!frontend/public/source-video/hd/*.mp4
!nsgame/public/source-video/*.mp4
# Exception: pitch deck (rendered from video/, served by frontend/)
!frontend/public/pitchdeck/*.mp4
!frontend/public/pitchdeck/slides/*.mp4
!frontend/public/room/*.mp4

# Stress test reports
scripts/stress-test/reports/

# CoinGecko logo images (~8800 files)
data/logos/

# YouTube research data
_bmad-output/

# Python virtual environments
vision-bot/.venv/

# Environment files with secrets
.env.*
!.env.example

# Root-level screenshots from debugging sessions
/*.png

# VPS credentials
vps.md

# Docker override YAMLs with secrets (generated by testnet.sh)
.*-override.yml
.archive/
.gstack/

# Source audit snapshots — large per-run dumps, not source of truth
audit-data/

# Invite codes — generated locally, never committed
waitlist-codes.txt
waitlist-codes.sql

# Keeper progress files — large local audit trails, not source of truth
deployments/reconcile-phantom-*.json
deployments/refund-progress-*.json

# Jarvis runtime
jarvis/.venv/
jarvis/state/*.json
jarvis/__pycache__/
jarvis/**/__pycache__/

# AIRPLANE work-program screenshots captured via ./shot — local scratch, do not commit
/image*.png
