[Unit]
Description=Prediction-market event indexer — Solana logs to Postgres
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=indexer
Group=indexer
WorkingDirectory=/opt/prediction-indexer
EnvironmentFile=/etc/indexer.env
ExecStart=/opt/prediction-indexer/prediction-market-indexer
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening — the daemon needs nothing beyond a network socket and a
# way to talk to Postgres. Lock everything else down.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# Memory ceiling — the bounded block_time cache holds at most 20k
# entries (~400 KB). 256 MB is absurdly generous.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
