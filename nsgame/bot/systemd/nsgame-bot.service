[Unit]
Description=nsgame betting load bot (devnet only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/nsgame-bot.env
WorkingDirectory=/root/bot-nsgame
ExecStart=/root/bot-nsgame/.venv/bin/python -u bot.py
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
