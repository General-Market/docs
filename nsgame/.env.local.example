# Frontend Environment Variables
# This file is synced from root .env via sync-env.sh
# All NEXT_PUBLIC_* variables are exposed to the browser

# Base Network RPC endpoint (exposed to browser for wallet connection)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_RPC_FALLBACK_URL=https://base.llamarpc.com

# Smart contract addresses (Base mainnet - deployed 2026-01-23)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xdbDD446F158cA403e70521497CC33E0A53205f74
NEXT_PUBLIC_RESOLUTION_CONTRACT_ADDRESS=0xed4F750fBdc860ECa19E7286452d61737D733f23

# Backend API URL (exposed to browser for data fetching)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Curator API URL (backend for lending quotes / Morpho bundler)
NEXT_PUBLIC_CURATOR_API_URL=

# L3 RPC URL (Orbit L3 chain - used for direct L3 reads)
NEXT_PUBLIC_L3_RPC_URL=

# L3 block explorer URL (for transaction links)
NEXT_PUBLIC_L3_EXPLORER_URL=

# WalletConnect Project ID (required for WalletConnect integration)
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id_here

# Chain ID (Base mainnet = 8453)
NEXT_PUBLIC_CHAIN_ID=8453

# ── Solana / nsgame ───────────────────────────────────────────────────────
# Devnet RPC. Helius free tier — replace <your-key> with a real key.
NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=<your-key>

# Prediction-market program ID. Devnet, deployed 2026-04.
NEXT_PUBLIC_PROGRAM_ID=DQwMnwQGYuLDvciSFZNgUvcHkA3Buyhk3ejgbACvSydA

# Stake mint (devnet, 6 decimals). The program reads the canonical mint
# from GlobalConfig — this override is for the frontend's pre-flight only.
NEXT_PUBLIC_PREDICTION_STAKE_MINT=5BNaj6SeidyLp9PKRFTEKCTGsww9SQmsTp7yEqgHiEkT

# Indexer Postgres connection. The DB lives on VPS 3 bound to 127.0.0.1.
# For local dev, open an SSH tunnel:
#   ssh -N -L 5433:127.0.0.1:5432 vps3
# Then point this at the forwarded port. Leave unset to disable the
# /api/markets/[pda]/bets route gracefully — the UI keeps rendering, the
# bet feed simply stays empty.
POSTGRES_URL=postgres://indexer:<pwd>@127.0.0.1:5433/prediction_market_indexer

# Optional. The schema name the indexer writes to. Default: prediction_market.
# POSTGRES_SCHEMA=prediction_market

# ── Data-node (server-side, source price proxy) ──────────────────────────
# The /api/sources/[id]/price route forwards to ${DATA_NODE_URL}/v1/sources/{id}/price.
# The data-node listens on 127.0.0.1:8201 on VPS 3. For local dev open an
# SSH tunnel:
#   ssh -N -L 8201:127.0.0.1:8201 vps3
# Then leave this on its default. Failures degrade silently to a dash.
DATA_NODE_URL=http://127.0.0.1:8201

# ── CSP — runtime extensions ─────────────────────────────────────────────
# Appended to the connect-src directive defined in next.config.ts. Use this
# for Solana RPC endpoints and any other host the wallet adapter needs to
# reach. Static directives in next.config.ts already permit:
#   style-src   https://fonts.googleapis.com   (Solana Mobile Wallet Adapter modal CSS)
#   font-src    https://fonts.gstatic.com      (Solana Mobile Wallet Adapter Inter Tight)
#   img-src     https://station.jup.ag https://unified.jup.ag  (Jup wallet logos)
#   connect-src https://station.jup.ag https://unified.jup.ag
# Without those, the Jup UnifiedWalletProvider modal hangs on "opening".
CSP_CONNECT_EXTRA="https://devnet.helius-rpc.com wss://devnet.helius-rpc.com https://api.devnet.solana.com wss://api.devnet.solana.com"

# ── Faucet (dev only) ──────────────────────────────
# Mints stake-mint tokens to connected wallets for testing.
# Server route /api/faucet/mint reads the keypair from disk and signs.
# Hard-gated to devnet cluster.
NEXT_PUBLIC_FAUCET_ENABLED=1
FAUCET_KEYPAIR_PATH=/Users/maxguillabert/.config/solana/id.json

# ── PostHog analytics ─────────────────────────────────────
# nsgame project (US Cloud). Project ID 398795.
# Drives pageviews, autocapture, session replay, heatmaps, exception capture.
# Init lives in lib/posthog.ts; if the key is unset, the SDK silently no-ops.
NEXT_PUBLIC_POSTHOG_KEY=phc_kP8xM2eQWAnawhSE8uQozMeHeRs7ZurQzkqyGoqsBFUW
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
