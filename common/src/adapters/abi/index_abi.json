[
  {
    "type": "event",
    "name": "TradeRequest",
    "inputs": [
      { "name": "cycleNumber", "type": "uint256", "indexed": true },
      { "name": "pairId", "type": "bytes32", "indexed": true },
      { "name": "side", "type": "uint8", "indexed": false },
      { "name": "amount", "type": "uint256", "indexed": false },
      { "name": "limitPrice", "type": "uint256", "indexed": false }
    ],
    "anonymous": false
  },
  {
    "type": "function",
    "name": "confirmFills",
    "inputs": [
      { "name": "cycleNumber", "type": "uint256" },
      {
        "name": "fills",
        "type": "tuple[]",
        "components": [
          { "name": "orderId", "type": "uint256" },
          { "name": "fillPrice", "type": "uint256" },
          { "name": "fillAmount", "type": "uint256" },
          { "name": "cycleNumber", "type": "uint256" },
          { "name": "txHash", "type": "bytes32" }
        ]
      },
      { "name": "blsSignature", "type": "bytes" },
      { "name": "referenceNonce", "type": "uint256" },
      { "name": "signersBitmask", "type": "uint256" }
    ],
    "outputs": [],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "confirmBatch",
    "inputs": [
      { "name": "cycleNumber", "type": "uint256" },
      { "name": "orderIds", "type": "uint256[]" },
      { "name": "blsSignature", "type": "bytes" },
      { "name": "referenceNonce", "type": "uint256" },
      { "name": "signersBitmask", "type": "uint256" }
    ],
    "outputs": [],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "getOrder",
    "inputs": [
      { "name": "orderId", "type": "uint256" }
    ],
    "outputs": [
      {
        "name": "order",
        "type": "tuple",
        "components": [
          { "name": "id", "type": "uint256" },
          { "name": "user", "type": "address" },
          { "name": "pairId", "type": "bytes32" },
          { "name": "side", "type": "uint8" },
          { "name": "amount", "type": "uint256" },
          { "name": "limitPrice", "type": "uint256" },
          { "name": "slippageTier", "type": "uint256" },
          { "name": "deadline", "type": "uint256" },
          { "name": "itpId", "type": "bytes32" },
          { "name": "timestamp", "type": "uint256" },
          { "name": "status", "type": "uint8" }
        ]
      }
    ],
    "stateMutability": "view"
  },
  {
    "type": "function",
    "name": "getITP",
    "inputs": [
      { "name": "itpId", "type": "bytes32" }
    ],
    "outputs": [
      {
        "name": "itp",
        "type": "tuple",
        "components": [
          { "name": "name", "type": "bytes32" },
          { "name": "symbol", "type": "bytes32" },
          { "name": "creator", "type": "address" },
          { "name": "createdAt", "type": "uint256" },
          { "name": "feeRate", "type": "uint256" },
          { "name": "status", "type": "uint256" },
          { "name": "totalSupply", "type": "uint256" },
          { "name": "totalValue", "type": "uint256" },
          { "name": "assetCount", "type": "uint256" }
        ]
      }
    ],
    "stateMutability": "view"
  }
]
