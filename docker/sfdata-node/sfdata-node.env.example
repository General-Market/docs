# sfdata-node environment — copy to sfdata-node.env and fill in.
#
# Only the variables used by tube + cam sources matter. Every other source
# is skipped automatically at spawn time by SF_MODE.

# ---- Core (required) --------------------------------------------------------
# SF_MODE is set by the binary itself — do not override here.
# DATABASE_URL is passed via docker-compose command; omit from env file.

# ---- Tube sources -----------------------------------------------------------
TUBES_ENABLED=1
# Optional overrides; defaults are sane.
TUBES_TOP_N=20
TUBES_PH_PAGES=1
TUBES_PROFILE_BATCH=10
TUBES_SYNC_INTERVAL_SECS=300
TUBES_LISTING_REFRESH_HOURS=24

# ---- Chaturbate (affiliate ID) ---------------------------------------------
CHATURBATE_WM=your-affiliate-wm-id

# ---- Logging ---------------------------------------------------------------
RUST_LOG=info,sqlx=warn
