# Telegram — rotate the existing token before using it
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Waitlist Postgres — same DSN the frontend uses for WAITLIST_DATABASE_URL
WAITLIST_DATABASE_URL=postgres://user:pass@host:5432/dbname
WAITLIST_POLL_SECONDS=15

# Discord
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Gmail (IMAP App Password — needs 2FA on the account)
GMAIL_ENABLED=true
GMAIL_USER=max@generalmarket.io
GMAIL_APP_PASSWORD=
GMAIL_POLL_SECONDS=30
