# Telegram — from @BotFather. Required.
TELEGRAM_BOT_TOKEN=PUT-YOUR-BOTFATHER-TOKEN-HERE

# Hyperliquid vocabulary source (the radar). In Docker this is the bind-mounted /app/x-targeting.
X_TARGETING_DIR=/app/x-targeting

# twitterapi.io key — env wins; else a file path; else /tmp/.twapi_key.
# TWITTERAPI_API_KEY=
TWITTERAPI_KEY_FILE=/root/.secrets/twitterapi_io_key

# Account harvest
VIBE_SEED_HANDLE=vibe_trading
MAX_ACCOUNTS=40
# ACCOUNTS_SEED=hyperliquidx,stevenyuntcap   # extra handles to always watch (space/comma separated)

# Scan + calibration
SCAN_INTERVAL_MIN=10
SCAN_LOOKBACK_MIN=45
SCAN_PAGES=5                  # advanced_search pages per scan query (page correction)
CALIBRATION_WINDOW_DAYS=14    # measurement window — "2 weeks back so we have numbers"
TARGET_TWEETS_PER_DAY=15      # set the threshold so ~this many tweets/day fire
THRESHOLD_PERCENTILE=90       # fallback only, if the target/day can't be met
LASTTWEETS_MAX_PAGES=20       # page cap per account when covering the full window
RECALIBRATE_HOURS=168         # auto-recalibrate cadence (weekly; full pagination is not cheap)
AUTHOR_MIN_AGE_HOURS=6
SEEN_MAX_AGE_HOURS=48

# Cost guard — automatic scans skip once today's estimated twitterapi.io spend hits this.
DAILY_CAP_USD=2.00
