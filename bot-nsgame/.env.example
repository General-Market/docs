# Bot keypair JSON (Solana CLI format — array of 64 ints)
NSGAME_BOT_KEYPAIR_PATH=/root/.secrets/nsgame-bot.json

# Admin keypair = mint authority for the stake mint
NSGAME_ADMIN_KEYPAIR_PATH=/root/.secrets/nsgame-faucet.json

# Solana RPC (devnet only — bot refuses to start on mainnet)
NSGAME_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=...

# Program ID — bundled IDL also has this; the env override wins
NSGAME_PROGRAM_ID=DQwMnwQGYuLDvciSFZNgUvcHkA3Buyhk3ejgbACvSydA

# Stake mint
NSGAME_STAKE_MINT=5BNaj6SeidyLp9PKRFTEKCTGsww9SQmsTp7yEqgHiEkT

# Optional: cap daily USDC mint, in whole USDC (default 1_000_000)
NSGAME_MAX_DAILY_USDC_MINT=1000000

# Optional: cap SOL airdrop frequency in seconds (default 3600)
NSGAME_MIN_AIRDROP_INTERVAL=3600

# Optional: log level
RUST_LOG=info
