# Required: your wallet private key (with 0x prefix)
BOT_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional overrides (defaults in config.toml are fine)
# DEPOSIT_AMOUNT=10          # USDC per round (the deposit is the stake)
# STRATEGY=random            # random, momentum, contrarian, bullish, bearish
# MAX_BATCHES=50             # max joins per cycle, not a lifetime cap
# STAKE_PER_TICK is legacy and ignored — joinBatchDirect has no stake parameter
