# Testnet (L3 Orbit + Settlement Sonic)
# Switched by: ./switch-env.sh testnet

# ── PostHog analytics ───────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_rTaC0At9efC9t7WfFXisFDj1aAVnphjCEzQLYcofIBB
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Client-side (NEXT_PUBLIC_) ──────────────────────────────
NEXT_PUBLIC_CHAIN_ID=111222333
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.soniclabs.com
NEXT_PUBLIC_L3_CHAIN_ID=111222333
# Canonical hostname — the raw IP nginx vhost only answers static + the AP
# proxy. JSON-RPC POSTs at `/` get 405. Use the LE-fronted hostname so
# `/api/rpc` (server-side) and any direct call gets a 200.
NEXT_PUBLIC_L3_RPC_URL=https://rpc.generalmarket.io/
NEXT_PUBLIC_SETTLEMENT_CHAIN_ID=14601
NEXT_PUBLIC_AP_URL=https://rpc.generalmarket.io/ap
NEXT_PUBLIC_DATA_NODE_URL=https://api.generalmarket.io/data-node
# NEXT_PUBLIC_DATA_NODE_BROWSER_URL removed: direct HTTP URL causes mixed-content block on HTTPS.
# Browser always uses /api/dn proxy (see frontend/lib/config.ts).
NEXT_PUBLIC_VISION_API_URL=http://159.195.78.238/oracle1
NEXT_PUBLIC_ORACLE_URLS=http://159.195.78.238/oracle1,http://159.195.78.238/oracle2,http://159.195.78.238/oracle3

# ── Block explorers ──────────────────────────────────────
NEXT_PUBLIC_L3_EXPLORER_URL=http://159.195.79.153
NEXT_PUBLIC_SETTLEMENT_EXPLORER_URL=https://testnet.sonicscan.org
NEXT_PUBLIC_SETTLEMENT_CHAIN_NAME=Sonic Testnet
NEXT_PUBLIC_SETTLEMENT_NATIVE_NAME=Sonic
NEXT_PUBLIC_SETTLEMENT_NATIVE_SYMBOL=S

# Vision address — from active-deployment.json (updated 2026-03-24)
NEXT_PUBLIC_VISION_ADDRESS=0x94d540bb45975bd5a0c7ba9a15a0d34e378f6c61
NEXT_PUBLIC_FAUCET_ENABLED=true

# ── Server-side (API routes, next.config.ts rewrites) ───────
