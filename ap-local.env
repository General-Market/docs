# ============================================
# AP LOCAL CONFIGURATION
# For use with local Anvil chain (Chain ID: 111222333)
# ============================================

# API listen port
AP_PORT=9100

# Chain configuration
AP_RPC_URL=http://localhost:8545
AP_CHAIN_ID=111222333

# Index contract address (from e2e-full-system.json)
AP_INDEX_CONTRACT=0x610178dA211FEF7D417bC0e6FeD39F05609AD788

# Use mock Bitget with on-chain settlement
AP_MOCK_BITGET=true
AP_BITGET_VAULT=0xc6e7DF5E7b4f2A278906862b61205850344D4e7d

# Mock USDT (Story 7-18) - deployed by DeployLocalE2E
AP_MOCK_USDT=0x809d550fca64d94Bd9F66E60752A544199cfAC3D

# Deployment file for real chain mode
AP_DEPLOYMENT_FILE=deployments/e2e-full-system.json
AP_MOCK_CHAIN=false

# Private key (Anvil account 4 = AP account)
AP_PRIVATE_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a

# Logging
AP_LOG_LEVEL=debug

# Bitget credentials for real price fetching (source from shared file)
# Usage: source bitget-credentials.env && source ap-local.env
BITGET_API_KEY=${BITGET_API_KEY:-}
BITGET_API_SECRET=${BITGET_API_SECRET:-}
BITGET_API_PASSPHRASE=${BITGET_API_PASSPHRASE:-}
